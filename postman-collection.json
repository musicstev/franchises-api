{
  "info": {
    "_postman_id": "e2b6c9a0-6f2a-4b7e-9c0d-franchises-api",
    "name": "Franchises API",
    "description": "API reactiva para la gestión de franquicias, sus sucursales y los productos ofertados en cada sucursal.\n\nBase: {{baseUrl}}/api/franchises\n\nLas sucursales y productos se identifican por un `id` generado por el servidor (no por su nombre). Las peticiones 'Crear franquicia', 'Agregar sucursal' y 'Agregar producto' capturan automáticamente esos ids en variables de colección; el resto de peticiones los reutiliza.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "franchiseId",
      "value": "",
      "type": "string"
    },
    {
      "key": "branchId",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "branchName",
      "value": "Sucursal Chapinero",
      "type": "string"
    },
    {
      "key": "productName",
      "value": "Café Americano",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Crear franquicia",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201 || pm.response.code === 200) {",
              "    const body = pm.response.json();",
              "    if (body.id) {",
              "        pm.collectionVariables.set('franchiseId', body.id);",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Café Aroma\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/franchises",
          "host": ["{{baseUrl}}"],
          "path": ["api", "franchises"]
        },
        "description": "Crea una franquicia. Guarda automáticamente el `id` generado en la variable de colección `franchiseId`."
      },
      "response": []
    },
    {
      "name": "Actualizar nombre de franquicia",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Café Aroma Premium\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/franchises/{{franchiseId}}/name",
          "host": ["{{baseUrl}}"],
          "path": ["api", "franchises", "{{franchiseId}}", "name"]
        }
      },
      "response": []
    },
    {
      "name": "Agregar sucursal",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201 || pm.response.code === 200) {",
              "    const body = pm.response.json();",
              "    const last = body.branches && body.branches[body.branches.length - 1];",
              "    if (last && last.id) {",
              "        pm.collectionVariables.set('branchId', last.id);",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{branchName}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/franchises/{{franchiseId}}/branches",
          "host": ["{{baseUrl}}"],
          "path": ["api", "franchises", "{{franchiseId}}", "branches"]
        },
        "description": "Agrega una sucursal. Guarda automáticamente el `id` generado en la variable de colección `branchId`."
      },
      "response": []
    },
    {
      "name": "Actualizar nombre de sucursal",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sucursal Usaquén\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/franchises/{{franchiseId}}/branches/{{branchId}}/name",
          "host": ["{{baseUrl}}"],
          "path": ["api", "franchises", "{{franchiseId}}", "branches", "{{branchId}}", "name"]
        }
      },
      "response": []
    },
    {
      "name": "Agregar producto",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201 || pm.response.code === 200) {",
              "    const body = pm.response.json();",
              "    const branch = (body.branches || []).find(b => b.id === pm.collectionVariables.get('branchId'));",
              "    const last = branch && branch.products && branch.products[branch.products.length - 1];",
              "    if (last && last.id) {",
              "        pm.collectionVariables.set('productId', last.id);",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{productName}}\",\n  \"stock\": 50\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/franchises/{{franchiseId}}/branches/{{branchId}}/products",
          "host": ["{{baseUrl}}"],
          "path": ["api", "franchises", "{{franchiseId}}", "branches", "{{branchId}}", "products"]
        },
        "description": "Agrega un producto a la sucursal. Guarda automáticamente el `id` generado en la variable de colección `productId`."
      },
      "response": []
    },
    {
      "name": "Modificar stock de producto",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"stock\": 65\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/franchises/{{franchiseId}}/branches/{{branchId}}/products/{{productId}}/stock",
          "host": ["{{baseUrl}}"],
          "path": ["api", "franchises", "{{franchiseId}}", "branches", "{{branchId}}", "products", "{{productId}}", "stock"]
        }
      },
      "response": []
    },
    {
      "name": "Actualizar nombre de producto",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Café Americano Grande\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/franchises/{{franchiseId}}/branches/{{branchId}}/products/{{productId}}/name",
          "host": ["{{baseUrl}}"],
          "path": ["api", "franchises", "{{franchiseId}}", "branches", "{{branchId}}", "products", "{{productId}}", "name"]
        }
      },
      "response": []
    },
    {
      "name": "Eliminar producto",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/franchises/{{franchiseId}}/branches/{{branchId}}/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "franchises", "{{franchiseId}}", "branches", "{{branchId}}", "products", "{{productId}}"]
        }
      },
      "response": []
    },
    {
      "name": "Producto con más stock por sucursal",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/franchises/{{franchiseId}}/top-stock-products",
          "host": ["{{baseUrl}}"],
          "path": ["api", "franchises", "{{franchiseId}}", "top-stock-products"]
        }
      },
      "response": []
    }
  ]
}
